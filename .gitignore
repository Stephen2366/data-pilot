.env
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/

# SQLite 本地产物（LangGraph checkpoint、RAG 知识库索引等运行时生成，不入库）
*.db
*.sqlite
*.sqlite3

# `.agent_work/` 只保留临时目录骨架；AI 调研草稿和运行产物都不进入发布仓库。
.agent_work/*
!.agent_work/temp/
.agent_work/temp/*
!.agent_work/temp/.gitkeep

# 所有 AI 工具共享 .agent_work/temp/；临时 trace / 缓存不应成为版本化评测产物。

eval/traces/*.jsonl
!eval/traces/.gitkeep

*-dataset_items-export-*.csv
*-lf-dataset_items-export-*.csv

# TypeScript workspace 本地依赖、构建与浏览器测试产物
node_modules/
packages/data-pilot-contracts/dist/
mcp/dist/
web/.next/
web/coverage/
web/playwright-report/
web/test-results/

