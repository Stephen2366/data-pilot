{
  "$defs": {
    "ClarificationFieldView": {
      "description": "客户端可填写的单个 closed-world clarification 字段。",
      "properties": {
        "allowed_values": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "max_length": {
          "exclusiveMinimum": 0,
          "title": "Max Length",
          "type": "integer"
        },
        "value_type": {
          "enum": [
            "text",
            "time_range",
            "enum"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "value_type",
        "max_length"
      ],
      "title": "ClarificationFieldView",
      "type": "object"
    },
    "ClarificationView": {
      "description": "首次 pending 响应中的待补说明，不含任何已填写 value。",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/ClarificationFieldView"
          },
          "title": "Fields",
          "type": "array"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "prompt",
        "fields"
      ],
      "title": "ClarificationView",
      "type": "object"
    },
    "FollowUpActionView": {
      "description": "成功回答后客户端可选择的一种受控追问动作。",
      "properties": {
        "action": {
          "enum": [
            "adjust_sql_scope",
            "explain_same_evidence",
            "ask_related_evidence"
          ],
          "title": "Action",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ClarificationFieldView"
          },
          "title": "Fields",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "action",
        "label",
        "fields"
      ],
      "title": "FollowUpActionView",
      "type": "object"
    },
    "FollowUpView": {
      "description": "服务端签发的 follow-up 表单合同。",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/FollowUpActionView"
          },
          "title": "Actions",
          "type": "array"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "actions"
      ],
      "title": "FollowUpView",
      "type": "object"
    },
    "ThreadView": {
      "description": "合法 owner 可见的 thread/checkpoint 安全投影。",
      "properties": {
        "checkpoint_version": {
          "minimum": 1,
          "title": "Checkpoint Version",
          "type": "integer"
        },
        "clarification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClarificationView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "follow_up": {
          "anyOf": [
            {
              "$ref": "#/$defs/FollowUpView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "follow_up_budget_remaining": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Follow Up Budget Remaining",
          "type": "integer"
        },
        "state_version": {
          "title": "State Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "follow_up_ready",
            "follow_up_claimed",
            "resolved",
            "cleared"
          ],
          "title": "Status",
          "type": "string"
        },
        "thread_id": {
          "title": "Thread Id",
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "checkpoint_version",
        "state_version",
        "status",
        "expires_at"
      ],
      "title": "ThreadView",
      "type": "object"
    }
  },
  "description": "显式清理 thread 的结果；失败时不返回 raw thread 投影。",
  "properties": {
    "message": {
      "title": "Message",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "safety_status": {
      "enum": [
        "passed",
        "blocked"
      ],
      "title": "Safety Status",
      "type": "string"
    },
    "thread": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "ok",
    "reason_code",
    "safety_status",
    "message"
  ],
  "title": "ThreadControlResponse",
  "type": "object"
}
