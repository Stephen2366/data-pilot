APP_ENV=local
THREAD_CHECKPOINT_TTL_SECONDS=900

# MySQL SQLAlchemy URL.
# Fill in your local username, password, host, port, and database name.
# Example: mysql+pymysql://root:your_password@127.0.0.1:3306/datapilot_dev?charset=utf8mb4
DATABASE_URL=mysql+pymysql://<mysql_user>:<mysql_password>@<mysql_host>:3306/<database_name>?charset=utf8mb4

REDIS_URL=redis://localhost:6379/0
# 默认主模型：Qwen provider 读取 QWEN_MODEL；LLM_MODEL 仅作为 DeepSeek provider 的备用入口
LLM_PROVIDER=qwen
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# M25 运行可靠性：默认保持 45 秒、0 重试；实验只在当前 shell 临时覆盖。
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_RETRY_BACKOFF_SECONDS=1

# Optional provider-specific credentials. Keep real values in .env only.
# 当前默认使用 Qwen；DeepSeek 仍可通过 LLM_PROVIDER=deepseek 显式切换。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
DASHSCOPE_API_KEY=
# Qwen chat uses DashScope OpenAI-compatible API; embeddings use DashScope native embedding API.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen3.7-plus

# Optional Schema Retrieval backend. Defaults stay local and deterministic.
SCHEMA_VECTOR_BACKEND=inmemory
SCHEMA_EMBEDDING_PROVIDER=deterministic
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=datapilot_schema_docs
MILVUS_RESET_COLLECTION=false
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_DIMENSIONS=1024

# LangFuse Cloud (Phase 3B). Disabled by default; real keys stay in .env only.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Optional L3 judge model for eval. Empty means L3 judge is skipped unless CLI overrides it.
EVAL_JUDGE_MODEL=
